# Copy to backend/.env. Replace placeholders; never commit actual secrets.
APP_ENV=development
APP_DATA_DIR=
DATABASE_URL=postgresql+psycopg://mini_notebooklm:replace_with_local_password@localhost:5432/mini_notebooklm
VECTOR_STORE_BACKEND=chroma
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key
SUPABASE_STORAGE_BUCKET=documents
AUTH_SECRET=replace_with_base64_url_safe_32_byte_random_secret
AUTH_COOKIE_SAMESITE=strict
# Add the exact deployed frontend origin to this comma-separated allowlist.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional, only for the explicit legacy Chroma migration command:
# LEGACY_OWNER_IDENTIFIER=former_owner_username
# LEGACY_OWNER_PASSWORD_HASH=existing_pbkdf2_password_hash
